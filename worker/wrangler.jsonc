{
  // Data Worker for astro-night-planning-live. Free Workers plan only.
  // Deploy ONLY with: npx wrangler deploy --config worker/wrangler.jsonc
  // (the name below is explicit; this config never touches any other Worker).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "astro-night-planning-live-data",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  // Workers Caching: serves repeated tiles without running the Worker or
  // reading R2 (cache hits still count toward the 100k requests/day).
  "cache": { "enabled": true },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "astro-night-planning-live-data",
    },
  ],
  "observability": { "enabled": false },
  // Hourly: starts the GitHub "Hourly satellite clouds" workflow through the
  // workflow_dispatch API (GitHub's own schedule proved unreliable). Free plan:
  // 5 Cron Triggers per account; this uses 1. Needs the GH_DISPATCH_TOKEN secret.
  "triggers": { "crons": ["47 * * * *"] },
  // No "limits" block: custom CPU limits are a paid-plan setting. The free
  // plan already caps every request at 10 ms CPU; tile requests use well under 5 ms.
}
