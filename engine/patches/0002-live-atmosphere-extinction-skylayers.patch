+/*
+ * Function: core_extinction_airmass
+ * Kasten & Young (1989) relative airmass for an OBSERVED-frame direction.
+ * Returns 40 below the horizon.
+ */
+double core_extinction_airmass(const double observed_dir[3])
+{
+    double alt_deg = asin(fmin(1.0, fmax(-1.0, observed_dir[2]))) * DR2D;
+    double z;
+    if (alt_deg < 0) return 40.0;
+    z = 90.0 - alt_deg;
+    return 1.0 / (cos(z * DD2R) + 0.50572 * pow(96.07995 - z, -1.6364));
+}
