diff --git a/src/modules/skylayers.c b/src/modules/skylayers.c
new file mode 100644
index 0000000..3662560
--- /dev/null
+++ b/src/modules/skylayers.c
@@ -0,0 +1,204 @@
+/* Astro Night Planning additions to Stellarium Web Engine (AGPL-3.0).
+ *
+ * Two alt-az texture layers fed from JavaScript:
+ *
+ *   skyclouds   (render order 36: after stars, planets and the atmosphere,
+ *                before the landscape) - the forecast cloud deck.
+ *   skyterrain  (render order 41: after everything that lives in the sky) -
+ *                the real terrain silhouette and ground below it.
+ *
+ * Each layer is an equirectangular RGBA image in the OBSERVED frame:
+ * column u = azimuth (0 = north, increasing through east) over 0..360 deg,
+ * row v from alt_min (first row) to alt_max (last row).
+ *
+ * JS API: skylayers_set(layer, ptr, w, h, alt_min_deg, alt_max_deg)
+ *         with layer 0 = clouds, 1 = terrain. Width/height should be
+ *         powers of two.
+ */
+
+#include "swe.h"
+
+typedef struct {
+    texture_t *tex;
+    double alt_min, alt_max; // radians
+} layer_data_t;
+
+static layer_data_t g_layers[2];
+// Debug counters for the last frame: [layer][0]=tested, [1]=clipped, [2]=drawn.
+static int g_stats[2][3];
+
+EMSCRIPTEN_KEEPALIVE
+int skylayers_stat(int layer, int what) { return g_stats[layer & 1][what % 3]; }
+
+typedef struct skylayer {
+    obj_t   obj;
+    fader_t visible;
+    int     index;
+} skylayer_t;
+
+typedef struct {
+    const layer_data_t *layer;
+    double u0, du, v0, dv;
+} cell_t;
+
+// Map a cell's uv (0..1) to a direction in the OBSERVED frame.
+static void cell_map(const uv_map_t *map, const double v[2], double out[4])
+{
+    const cell_t *c = map->user;
+    // The OBSERVED frame is left-handed: walk azimuth backwards across the
+    // cell so the quad keeps the winding the renderer expects (otherwise it
+    // is back-face culled). The texture matrix mirrors u to match.
+    double az = (c->u0 + (1.0 - v[0]) * c->du) * 2 * M_PI;
+    double t = c->v0 + v[1] * c->dv;
+    double alt = c->layer->alt_min + t * (c->layer->alt_max - c->layer->alt_min);
+    vec3_from_sphe(az, alt, out);
+    out[3] = 0.0; // at infinity
+}
+
+static int skylayer_update(obj_t *obj, double dt)
+{
+    skylayer_t *sl = (skylayer_t*)obj;
+    return fader_update(&sl->visible, dt);
+}
+
+static int skylayer_render(obj_t *obj, const painter_t *painter_)
+{
+    skylayer_t *sl = (skylayer_t*)obj;
+    const layer_data_t *layer = &g_layers[sl->index];
+    painter_t painter;
+    const int NU = 72; // 5 deg of azimuth per cell
+    int i, j, nv;
+    double uv[3][3], cap[4], half_az, half_alt, alt_c;
+    cell_t cell;
+    uv_map_t map = {.map = cell_map, .user = &cell};
+
+    g_stats[sl->index][0] = g_stats[sl->index][1] = g_stats[sl->index][2] = 0;
+    if (!layer->tex || sl->visible.value == 0.0) return 0;
+    // The terrain layer is the ground itself: it must draw below the horizon
+    // even when the engine hides everything else there.
+    painter_t base = *painter_;
+    if (sl->index == 1) base.flags &= ~PAINTER_HIDE_BELOW_HORIZON;
+    // About 10 deg of altitude per cell.
+    nv = (int)ceil((layer->alt_max - layer->alt_min) / (10 * DD2R));
+    if (nv < 1) nv = 1;
+    cell.layer = layer;
+    cell.du = 1.0 / NU;
+    cell.dv = 1.0 / nv;
+    half_az = M_PI / NU;
+    half_alt = (layer->alt_max - layer->alt_min) / nv / 2;
+    for (i = 0; i < NU; i++) {
+        for (j = 0; j < nv; j++) {
+            cell.u0 = i * cell.du;
+            cell.v0 = j * cell.dv;
+            // Skip cells outside the viewport. This matters: paint_quad does
+            // not split quads at the projection discontinuity behind the
+            // viewer, so such a cell would be smeared over the whole screen.
+            alt_c = layer->alt_min + (j + 0.5) * cell.dv *
+                    (layer->alt_max - layer->alt_min);
+            vec3_from_sphe((i + 0.5) * cell.du * 2 * M_PI, alt_c, cap);
+            cap[3] = cos(sqrt(half_az * half_az + half_alt * half_alt) * 1.1);
+            g_stats[sl->index][0]++;
+            if (painter_is_cap_clipped(&base, FRAME_OBSERVED, cap)) {
+                g_stats[sl->index][1]++;
+                continue;
+            }
+            g_stats[sl->index][2]++;
+            painter = base;
+            painter.color[3] *= sl->visible.value;
+            mat3_set_identity(uv);
+            mat3_itranslate(uv, cell.u0 + cell.du, cell.v0);
+            mat3_iscale(uv, -cell.du, cell.dv, 1.0);
+            painter_set_texture(&painter, PAINTER_TEX_COLOR, layer->tex, uv);
+            paint_quad(&painter, FRAME_OBSERVED, &map, 4);
+        }
+    }
+    return 0;
+}
+
+static int skyclouds_init(obj_t *obj, json_value *args)
+{
+    skylayer_t *sl = (skylayer_t*)obj;
+    sl->index = 0;
+    fader_init(&sl->visible, true);
+    return 0;
+}
+
+static int skyterrain_init(obj_t *obj, json_value *args)
+{
+    skylayer_t *sl = (skylayer_t*)obj;
+    sl->index = 1;
+    fader_init(&sl->visible, true);
+    return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void skylayers_set(int index, const uint8_t *data, int w, int h,
+                   double alt_min_deg, double alt_max_deg)
+{
+    layer_data_t *l;
+    if (index < 0 || index > 1) return;
+    l = &g_layers[index];
+    if (!data || w <= 0 || h <= 0) {
+        texture_release(l->tex);
+        l->tex = NULL;
+        return;
+    }
+    if (l->tex && l->tex->w == w && l->tex->h == h) {
+        texture_set_data(l->tex, data, w, h, 4);
+    } else {
+        texture_release(l->tex);
+        l->tex = texture_from_data(data, w, h, 4, 0, 0, w, h, 0);
+    }
+    l->alt_min = alt_min_deg * DD2R;
+    l->alt_max = alt_max_deg * DD2R;
+}
+
+/*
+ * Window position (CSS pixels, origin top-left) to azimuth / altitude in the
+ * OBSERVED frame (radians, refraction included). Returns 0 if the point is
+ * outside the projection. Used for the "airmass at cursor" readout.
+ */
+EMSCRIPTEN_KEEPALIVE
+int skylayers_win_to_altaz(double x, double y, double *out)
+{
+    projection_t proj;
+    double p[3] = {x, y, 0}, v[3], o[3], az, alt;
+    core_get_proj(&proj);
+    if (!unproject(&proj, p, v)) return 0;
+    convert_frame(core->observer, FRAME_VIEW, FRAME_OBSERVED, true, v, o);
+    vec3_normalize(o, o);
+    vec3_to_sphe(o, &az, &alt);
+    out[0] = az;
+    out[1] = alt;
+    return 1;
+}
+
+static obj_klass_t skyclouds_klass = {
+    .id = "skyclouds",
+    .size = sizeof(skylayer_t),
+    .flags = OBJ_IN_JSON_TREE | OBJ_MODULE,
+    .init = skyclouds_init,
+    .update = skylayer_update,
+    .render = skylayer_render,
+    .render_order = 36,
+    .attributes = (attribute_t[]) {
+        PROPERTY(visible, TYPE_BOOL, MEMBER(skylayer_t, visible.target)),
+        {}
+    },
+};
+OBJ_REGISTER(skyclouds_klass)
+
+static obj_klass_t skyterrain_klass = {
+    .id = "skyterrain",
+    .size = sizeof(skylayer_t),
+    .flags = OBJ_IN_JSON_TREE | OBJ_MODULE,
+    .init = skyterrain_init,
+    .update = skylayer_update,
+    .render = skylayer_render,
+    .render_order = 41,
+    .attributes = (attribute_t[]) {
+        PROPERTY(visible, TYPE_BOOL, MEMBER(skylayer_t, visible.target)),
+        {}
+    },
+};
+OBJ_REGISTER(skyterrain_klass)
